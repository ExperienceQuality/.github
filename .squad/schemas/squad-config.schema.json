{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XQ Squad Configuration",
  "type": "object",
  "required": ["name", "version", "release_tag", "config_schema_version", "memory_schema_version", "components", "ownership"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release_tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "config_schema_version": { "type": "string" },
    "memory_schema_version": { "type": "string" },
    "repository": { "type": "string", "format": "uri" },
    "description": { "type": "string" },
    "runtimes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["adapter_root"],
        "properties": {
          "adapter_root": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "agents": { "type": "object", "additionalProperties": { "$ref": "#/definitions/component" } },
        "skills": { "type": "object", "additionalProperties": { "$ref": "#/definitions/component" } },
        "workflows": { "type": "object", "additionalProperties": { "$ref": "#/definitions/component" } },
        "schemas": { "type": "object", "additionalProperties": { "$ref": "#/definitions/component" } },
        "rules": { "type": "object", "additionalProperties": { "$ref": "#/definitions/component" } },
        "hooks": { "type": "object", "additionalProperties": { "$ref": "#/definitions/component" } }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "properties": {
        "upstream_managed": { "type": "array", "items": { "type": "string" } },
        "merge_managed": { "type": "array", "items": { "type": "string" } },
        "consumer_owned": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["upstream_managed", "merge_managed", "consumer_owned"]
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["path", "managed"],
      "properties": {
        "path": { "type": "string" },
        "devin_profile": { "type": "string" },
        "cursor_profile": { "type": "string" },
        "cursor_path": { "type": "string" },
        "description": { "type": "string" },
        "managed": { "type": "boolean" }
      }
    }
  }
}
