{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/xq-squad-git-guard.mjs",
        "matcher": "git\\s.*\\b(commit|push)\\b|gh\\s+(pr\\s+create|release\\s+create)",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/xq-squad-scope-guard.mjs",
        "matcher": "Write|Delete",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/xq-squad-verify-reminder.mjs",
        "timeout": 15,
        "loop_limit": 1
      }
    ]
  }
}
